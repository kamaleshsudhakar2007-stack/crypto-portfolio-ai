# Copy to .env (same folder as pom.xml). Never commit .env.
# Local MongoDB (default). For Atlas use: mongodb+srv://USER:PASS@cluster.mongodb.net/crypto_portfolio
MONGODB_URI=mongodb://localhost:27017/crypto_portfolio?serverSelectionTimeoutMS=3000
# Optional: CoinGecko free "demo" key (raises rate limits). Leave blank to use the public endpoint.
COINGECKO_API_KEY=
# Optional: Google Gemini free-tier key for AI summaries. Leave blank for rule-based insights only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
